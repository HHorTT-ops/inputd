{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inputd.local/schemas/command.schema.json",
  "title": "inputd CommandRequest",
  "type": "object",
  "required": ["version", "sequence", "actions"],
  "properties": {
    "version": { "const": "1.0" },
    "sequence": { "type": "integer", "minimum": 0 },
    "deadline_us": { "type": "integer", "minimum": 0 },
    "exclusive": { "type": "boolean", "default": true },
    "actions": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "action.schema.json" } }
  },
  "additionalProperties": false
}
